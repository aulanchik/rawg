# Required. Get a free key at https://rawg.io/apidocs
RAWG_API_KEY=

# Optional. Comma-separated keys clients must send in the X-API-Key header.
# Leave empty to leave the proxy open (not recommended for a public deployment).
PROXY_API_KEYS=

# Server
PORT=3000
NODE_ENV=development

RAWG_API=https://api.rawg.io/api
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=3

# Local rate limiter (defaults shown)
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_RATE=10

# Response cache: "memory" (default) or "redis"
CACHE_DRIVER=memory
CACHE_TTL_SECONDS=3600
# Maximum entries for the memory driver
CACHE_MAX_ENTRIES=500

# Redis driver. REDIS_URL is required when CACHE_DRIVER=redis (use rediss:// for TLS).
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=rawg-proxy:cache:
# REDIS_COMMAND_TIMEOUT_MS=500
